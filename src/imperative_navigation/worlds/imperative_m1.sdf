<?xml version="1.0" ?>
<!-- M1-sized holonomic robot, a 8 m x 6.4 m room, and static / moving cylinder obstacles. -->
<sdf version="1.9">
  <world name="imperative_m1">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>

    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>12 12 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 12 0.1</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>

    <model name="wall_north"><pose>0 3.25 0.5 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>8.2 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.2 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><pose>0 -3.25 0.5 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>8.2 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.2 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><pose>4.05 0 0.5 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.1 6.6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.6 1</size></box></geometry></visual></link></model>
    <model name="wall_west"><pose>-4.05 0 0.5 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.1 6.6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.6 1</size></box></geometry></visual></link></model>

    <!-- This cylinder lies on the direct start-to-goal line, so reaching the
         goal requires a genuine static-obstacle detour. -->
    <model name="static_obstacle_1"><pose>-3.0 2.2 0.3 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry><material><diffuse>0.85 0.2 0.2 1</diffuse></material></visual></link></model>
    <!-- Yellow obstacle on the initial direct route: it must be avoided
         before the red centre obstacle at (0, 0). -->
    <model name="static_obstacle_2"><pose>-2.05 -1.18 0.3 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry><material><diffuse>1 0.75 0.05 1</diffuse></material></visual></link></model>
    <!-- Visual-only marker for the original planner's GOAL = (2.5, 1.5). -->
    <model name="goal_marker"><pose>2.5 1.5 0.02 0 0 0</pose><static>true</static><link name="link"><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><cylinder><radius>0.20</radius><length>0.03</length></cylinder></geometry><material><diffuse>1 0.85 0.05 1</diffuse><emissive>0.5 0.4 0 1</emissive></material></visual></link></model>

    <!-- The ROS motion node teleports these kinematic collision cylinders at 10 Hz
         through Gazebo's set_pose service, using independent random waypoints. -->
    <model name="moving_obstacle_1"><pose>2.35 2.35 0.3 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry><material><diffuse>0.95 0.55 0.05 1</diffuse></material></visual></link></model>
    <model name="moving_obstacle_2"><pose>3.10 1.35 0.3 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry><material><diffuse>0.2 0.65 0.25 1</diffuse></material></visual></link></model>
    <model name="moving_obstacle_3"><pose>2.40 0.55 0.3 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry><material><diffuse>0.25 0.4 0.95 1</diffuse></material></visual></link></model>

    <model name="m1" xmlns:ignition="http://ignitionrobotics.org/schema"><pose>-2.5 -1.5 0 0 0 0</pose>
      <link name="base_link"><pose>0 0 0.11 0 0 0</pose><inertial><mass>1.2</mass><inertia><ixx>0.01</ixx><iyy>0.015</iyy><izz>0.02</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.32 0.28 0.12</size></box></geometry></collision><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><box><size>0.32 0.28 0.12</size></box></geometry><material><diffuse>0.1 0.45 0.9 1</diffuse></material></visual><!-- Match Gazebo Sim 6's bundled GPU-LiDAR SDF example. --><sensor name="lidar" type="gpu_lidar"><pose>0 0 0.25 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.106879</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.08</min><max>10.0</max><resolution>0.01</resolution></range></lidar><alwaysOn>1</alwaysOn><visualize>false</visualize></sensor></link>
      <link name="front_left_wheel"><pose>0.13 0.13 0.05 -1.5708 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry></visual></link>
      <link name="front_right_wheel"><pose>0.13 -0.13 0.05 -1.5708 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry></visual></link>
      <link name="back_left_wheel"><pose>-0.13 0.13 0.05 -1.5708 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry></visual></link>
      <link name="back_right_wheel"><pose>-0.13 -0.13 0.05 -1.5708 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision><visual name="visual"><visibility_flags>0x01</visibility_flags><geometry><cylinder><radius>0.045</radius><length>0.035</length></cylinder></geometry></visual></link>
      <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>5</effort><velocity>30</velocity></limit></axis></joint>
      <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>5</effort><velocity>30</velocity></limit></axis></joint>
      <joint name="back_left_wheel_joint" type="revolute"><parent>base_link</parent><child>back_left_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>5</effort><velocity>30</velocity></limit></axis></joint>
      <joint name="back_right_wheel_joint" type="revolute"><parent>base_link</parent><child>back_right_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>5</effort><velocity>30</velocity></limit></axis></joint>
      <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive"><front_left_joint>front_left_wheel_joint</front_left_joint><front_right_joint>front_right_wheel_joint</front_right_joint><back_left_joint>back_left_wheel_joint</back_left_joint><back_right_joint>back_right_wheel_joint</back_right_joint><wheel_separation>0.26</wheel_separation><wheelbase>0.26</wheelbase><wheel_radius>0.045</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><min_acceleration>-1.0</min_acceleration><max_acceleration>1.0</max_acceleration></plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher"><odom_frame>odom</odom_frame><robot_base_frame>base_link</robot_base_frame><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><dimensions>2</dimensions></plugin>
    </model>
  </world>
</sdf>
