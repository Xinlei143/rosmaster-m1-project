<?xml version="1.0"?>
<sdf version="1.9">
  <model name="imperative_dynamic_long_box">
    <pose>0 0 0.30 0 0 0</pose>
    <link name="link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial><mass>100.0</mass><inertia><ixx>3.0</ixx><iyy>3.0</iyy><izz>3.0</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>1.00 0.45 0.60</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.00 0.45 0.60</size></box></geometry>
        <material><ambient>0.15 0.35 0.95 1</ambient><diffuse>0.15 0.35 0.95 1</diffuse></material>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl"/>
  </model>
</sdf>
