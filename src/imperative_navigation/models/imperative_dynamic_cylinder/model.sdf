<?xml version="1.0"?>
<sdf version="1.9">
  <model name="imperative_dynamic_cylinder">
    <pose>0 0 0.30 0 0 0</pose>
    <link name="link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial><mass>100.0</mass><inertia><ixx>3.0</ixx><iyy>3.0</iyy><izz>3.0</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.30</radius><length>0.60</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.30</radius><length>0.60</length></cylinder></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl"/>
  </model>
</sdf>
