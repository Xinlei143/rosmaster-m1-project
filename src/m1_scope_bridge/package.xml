<?xml version="1.0"?>
<package format="3">
  <name>m1_scope_bridge</name>
  <version>0.1.0</version>
  <description>Offline rosbag export and SCOPE-compatible preprocessing for Rosmaster M1.</description>
  <maintainer email="user@example.com">Rosmaster user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>rosgraph_msgs</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
